@model EF_Practice.Models.Courses

@{
    ViewData["Title"] = "Edit";
}
<div class="container bg-info col-8 p-2">
    <h1 class="text-center">Edit Courses</h1>
    <hr />
    <div class="row">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CId" />
            <div class="form-group">
                <label asp-for="CName" class="control-label"></label>
                <input asp-for="CName" class="form-control" />
                <span asp-validation-for="CName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CFee" class="control-label"></label>
                <input asp-for="CFee" class="form-control" />
                <span asp-validation-for="CFee" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CDuration" class="control-label"></label>
                <input asp-for="CDuration" class="form-control" />
                <span asp-validation-for="CDuration" class="text-danger"></span>
            </div>
            <div class="form-group p-2">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>