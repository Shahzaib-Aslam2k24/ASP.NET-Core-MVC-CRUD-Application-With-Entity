
@{
    ViewData["Title"] = "Create";
}
@model Courses
<div class="container bg-info col-8 p-2">
    <h1 class="text-center">Add Courses</h1>
    <hr />
    <div class="row">
        
            <form asp-action="Create">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="CName" class="control-label text-white"></label>
                    <input asp-for="CName" class="form-control" />                    
                </div>
                <div class="form-group">
                <label asp-for="CFee" class="control-label text-white"></label>
                    <input asp-for="CFee" class="form-control" />                    
                </div>
                <div class="form-group">
                <label asp-for="CDuration" class="control-label text-white"></label>
                    <input asp-for="CDuration" class="form-control" />                   
                </div>
                <div class="form-group mt-3 mb-3">
                    <input type="submit" value="Add" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
</div>