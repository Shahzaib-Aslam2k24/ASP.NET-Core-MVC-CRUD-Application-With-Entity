@{
    ViewData["Title"] = "Confirmation";
}
@model Studentdata
<h1 class="col-12 text-danger">Would you like to delete your data!</h1>
<div class="bg-success border rounded-2  p-5 col-12">
    <h2>City is : <span>@Model.city</span></h2>
    <h2>Phone no is : <span>@Model.phone</span></h2>
    <h2>Courses is : <span>@Model.course</span></h2>
    <div class="d-grid gap-2 mt-4 mb-2">
        <a class="btn btn-primary" type="button" asp-controller="Home" asp-action="Index">Home</a>
    </div>
    <div class="d-grid gap-2 mt-2">
        <a class="btn btn-danger" type="button" asp-controller="Home" asp-action="delete" asp-route-id="@Model.id">Delete</a>
    </div>
</div>

